###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_TENANT_BASE_DOMAIN=localhost
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL points at the CENTRAL database (tenant registry / routing / provisioning
# metadata only — ADR-001). The docker compose `app` service overrides this with the
# in-network value. Tenant databases are opened at runtime from the tenant registry.
DATABASE_URL="postgresql://root:root@database:5432/central?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app/tenant-connectivity ###
# Placeholder template for the named `tenant` Doctrine connection. Its parameters
# are NEVER used to connect: the tenancy routing layer builds the real connection
# at runtime from each tenant's registry location metadata. Kept only so Symfony
# can construct the tenant EntityManager/connection services and their config.
TENANT_DATABASE_URL="postgresql://tenant@127.0.0.1:5432/_tenant_template?serverVersion=16&charset=utf8"
# Dev credentials backend: the EnvTenantCredentialsResolver resolves every tenant's
# indirect credentialsReference to these shared cluster credentials. Replace the
# resolver with a real secrets backend (Vault, SM, ...) in production.
TENANT_DB_USER=root
TENANT_DB_PASSWORD=root
###< app/tenant-connectivity ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://central?auto_setup=0
###< symfony/messenger ###
