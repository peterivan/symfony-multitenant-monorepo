        "@vue/test-utils": "^2.4.6",
        "eslint": "^9.16.0",
        "eslint-plugin-vue": "^9.32.0",
        "jsdom": "^25.0.1",
        "typescript": "^5.7.2",
        "vite": "^6.0.3",
